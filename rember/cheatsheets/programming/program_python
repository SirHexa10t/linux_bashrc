# enum
 
class Color(Enum):
  RED = (255, 0, 0)
  GREEN = (0, 255, 0)
  BLUE = (0, 0, 255)

# iterating on enum instances:
color_names = [color.name for color in Color]
color_values = [color.value for color in Color]

print(f"R value of GREEN: {Color.GREEN.value[0]}")






# string operations

> remove strings from ends
"hello world!!!".removeprefix('hello ').removesuffix('!')  # world

> repeatedly remove string from ends
"hello world!!!".lstrip('h').rstrip('!')  # ello world

> replace text (string substitution)
mystr = "hello world!!!"
mystr = re.sub('world', 'universe', mystr)  # mystr = 'hello universe!!!'




